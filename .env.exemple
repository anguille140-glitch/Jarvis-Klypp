# Copie ce fichier en « .env » et remplis les valeurs (ne publie jamais ton .env).
# Cerveau : hybride (Gemini d'abord, IA locale en secours, défaut) | local (local d'abord) | local_seul | gemini
JARVIS_IA=hybride
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
FACEIT_API_KEY=
JARVIS_INPUT_DEVICE=
# Ta position pour le plan de travail (reste sur ton PC) : adresse précise, ou juste la ville
JARVIS_ADRESSE=
JARVIS_VILLE=
