# Copie ce fichier en « .env » et remplis les valeurs (ne publie jamais ton .env).
# Cerveau : local (100 % sur le PC, gratuit) | hybride (local + Gemini gratuit pour les gros travaux) | gemini
JARVIS_IA=local
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
FACEIT_API_KEY=
JARVIS_INPUT_DEVICE=
