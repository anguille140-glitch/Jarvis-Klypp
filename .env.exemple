# Copie ce fichier en « .env » et remplis les valeurs (ne publie jamais ton .env).
# Cerveau : hybride (Gemini d'abord, IA locale en secours, défaut) | local (local d'abord) | local_seul | gemini
JARVIS_IA=hybride
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
FACEIT_API_KEY=
JARVIS_INPUT_DEVICE=
# Ta position pour le plan de travail (reste sur ton PC) : adresse précise, ou juste la ville
JARVIS_ADRESSE=
JARVIS_VILLE=
# Bruitages de l'animation du plan de travail : 0 = coupés, 100 = fort (60 par défaut)
JARVIS_PLAN_SONS=30
# Mode jeu automatique (Jarvis se fait discret pendant tes parties) : non = désactivé
JARVIS_MODE_JEU=oui
# Jeux en plus de la liste intégrée (noms des .exe, séparés par des virgules)
JARVIS_JEUX=
# Session CS : chemin de FACEIT AC si Jarvis ne le trouve pas, et secondes laissées à l anti-triche avant CS2
JARVIS_FACEIT_AC=
JARVIS_FACEIT_ATTENTE=6
# Vitrine CS2 (« lance mon fond d'écran ») : écran où elle s'ouvre (principal ou gauche)
JARVIS_VITRINE_ECRAN=principal
# Scan d'arrivée : la webcam te reconnaît quand tu reviens au PC (non = désactivé)
JARVIS_ACCUEIL=oui
# Minutes d'absence avant un nouveau scan
JARVIS_ACCUEIL_ABSENCE=5
# Lancement : mot (phrases + double clap, défaut) | voix (phrases seulement) | clap (clap seulement)
JARVIS_LANCEMENT=mot
# Phrases de lancement en plus (séparées par des virgules) ; « salut jarvis », « bonjour jarvis »... marchent déjà
#JARVIS_MOT_LANCEMENT=salut jarvis,yo jarvis
# Jarvis en sommeil : ton visage reconnu à ton retour le lance (non = désactivé)
JARVIS_LANCEMENT_VISAGE=oui
# Animation « À bientôt » quand tu fermes Jarvis (non = désactivée)
JARVIS_ANIMATION_SORTIE=oui
